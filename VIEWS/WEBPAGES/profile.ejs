<% layout('LAYOUTS/boilerplate.ejs') %>

    <body>
        <%- include('../INCLUDES/navbar.ejs') %>
            <%- include("../INCLUDES/flash.ejs") %>

                <div class="container ">
                    <div class="container inner-1 mt-5 mb-5 " style="background-color: aliceblue;">
                        <div class="row mb-3 justify-content-center mt-1 mb-3"
                            style="background:linear-gradient(to right,#d4fcf4, #8ed6ff); border-radius: 10px 10px 0 0 ;">
                            <h2 class="text-center mt-1">Profile Details</h2>
                        </div>
                        <div class="ms-3 me-3 mb-3">
                            <h4 class="mb-3">Personal Information</h4>
                            <div class="row">
                                <div class="col-6">Full Name</div>
                                <div class="col-6">
                                    <%= currUser.fullname %>
                                </div>
                            </div>
                            <hr>
                            <div class="row">
                                <div class="col-6">Username</div>
                                <div class="col-6">
                                    <%= currUser.username %>
                                </div>
                            </div>
                            
                        </div>

                        <div class="ms-3 me-3 mt-3 mb-4">
                            <h4 class="mb-3">Contact Information</h4>
                            <div class="row">
                                <div class="col-6">Email</div>
                                <div class="col-6 text-break">
                                    <%= currUser.email %>
                                </div>
                            </div>

                        </div>
                        <a href="/profile/<%= currUser._id %>/edit"><button type="submit"
                                style="width: 100%; background: linear-gradient(to right, #d4fcf4, #8ed6ff); color: black;"
                                class="btn btn-primary mb-4">Update Profile</button></a>
                    </div>
                </div>

                <%- include('../INCLUDES/footer.ejs') %>
    </body>