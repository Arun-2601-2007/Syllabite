<style>

.card-container {
  display: flex;
  gap: 30px;
  flex-wrap: wrap;
  justify-content: center;
}

.card {
  background-color: #fff;
  border-radius: 15px;
  padding: 20px 20px;
  border-radius: 10px;
box-shadow: 0 2px 8px rgb(34, 231, 231);
  width: 320px;
  text-align: left;
}

.card h3 {
  margin-bottom: 15px;
  font-size: 1.3rem;
  color: #111;
}

.card p {
  margin: 5px 0;
  color: black;
  line-height: 1.4;
}

.card .btn {
  display: inline-block;
  margin-top: 15px;
  padding: 10px 18px;
  color: black !important;
  background: linear-gradient(to right, #d4fcf4, #8ed6ff);
  color: #fff;
  text-decoration: none;
  border-radius: 8px;
  font-weight: 500;
  transition: background 0.3s, transform 0.3s;
}
.card .btn {
  transition: 0.3s ease-in-out;
}
.wdt {
    height: 50%;
}
.card .btn:hover {
  transform: translateY(-3px);
  background: #c0e8ff;
}
</style>


<% layout('LAYOUTS/boilerplate.ejs') %>

    <body>
        <%- include('../INCLUDES/navbar.ejs') %>
        <%- include("../INCLUDES/flash.ejs") %>

        <section class="back mt-4">
        <div class="container  text-center p-3">
            <h2><b >Interview Experiences</b></h2>
            <p class="adjust">Discover real interview journeys shared by candidates across top companies. Each experience is organized round-by-round, giving you clear insights into questions asked, challenges faced, and tips that truly help. Everything is neatly structured so you can prepare smarter, faster, and with more confidence.</p>
        </div>
    </section>

    <div class="container mt-3 mb-5">
        <div class="row justify-content-center">
            <div class="card-container">
            <% for (experience of data) { %>
                
                    <div class="card">
                        <h3 class="text-center"><%= experience.jobtitle %></h3>
                        <p><strong>Company :</strong> <%= experience.company %></p>
                        <p><strong>Interview Type :</strong> <%= experience.interviewtype %></p>
                        <p><strong>Total Rounds :</strong> <%= experience.totalrounds %></p>
                        <p><strong>Status :</strong> <%= experience.status %></p>
                        <p><%= experience.summary %></p>
                        <a href="/interview/<%= experience._id %>" class="btn">Read Full Experience <i class="fa-solid fa-arrow-right"></i></a>
                        <div class="d-flex gap-2 justify-content-evenly">
                            <a href="/interview/<%= experience._id %>/edit" class="btn w-50">Edit</a>
                            <form class="w-50"  onsubmit="return confirm('Are you sure you want to delete?');"  action="/interview/<%= experience._id %>?_method=DELETE" method="POST"><button type="submit" class="btn w-100">Delete</button></form>
                        </div>
                    </div>
                
            <% } %>
            </div>
        </div>
    </div>

       

        <%- include('../INCLUDES/footer.ejs') %>
    </body>
