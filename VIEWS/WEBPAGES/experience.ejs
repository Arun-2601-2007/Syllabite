<head>
    <script src="https://code.jquery.com/jquery-3.5.1.min.js"></script>
    <link href="https://cdn.jsdelivr.net/npm/summernote@0.8.20/dist/summernote-lite.min.css" rel="stylesheet">
    <script src="https://cdn.jsdelivr.net/npm/summernote@0.8.20/dist/summernote-lite.min.js"></script>

</head>

<% layout('LAYOUTS/boilerplate.ejs') %>

    <body>
        <%- include('../INCLUDES/navbar.ejs') %>

            <%- include("../INCLUDES/flash.ejs") %>
                <div class="container cnt-5 mt-5 mb-5" style="background-color: white;">
                    <h2 class="text-center mt-2">Add Experience</h2>
                    <form action="/interview" method="POST" class="mb-3 needs-validation">
                        <div class="row">
                            <div class="col-md-6 mt-2">
                                <input type="text" class="form-control" id="exampleInputEmail1" name="jobtitle" placeholder="Job Title" >
                            </div>
                            <div class="col-md-6 mt-3 mt-lg-2">
                                <input type="text" class="form-control" id="exampleInputEmail1" name="company" placeholder="Comapany Name">
                            </div>
                            <div class="col-md-6">
                                <div class="input-group mt-3">
                                    <label class="input-group-text" for="inputGroupSelect01" required>Interview Type</label>
                                    <select class="form-select" id="inputGroupSelect01" name="interviewtype" required>
                                        <option class="opt-1" selected disabled hidden>Choose...</option>
                                        <option class="opt-1" value="On-campus">On-campus</option>
                                        <option class="opt-1" value="Off-campus">Off-campus</option>
                                    </select>
                                </div>
                            </div>
                            <div class="col-md-6 mt-3">
                                <div class="input-group mb-3">
                                    <span class="input-group-text" id="inputGroup-sizing-default">Total Rounds</span>
                                    <input type="number" name="totalrounds" class="form-control"
                                        aria-label="Sizing example input" aria-describedby="inputGroup-sizing-default">
                                </div>
                            </div>
                            <div class="col-md-6">
                                <div class="input-group mb-3 col-md-4">
                                    <label class="input-group-text" for="inputGroupSelect02" required>Application Status</label>
                                    <select class="form-select" id="inputGroupSelect02" name="status" required>
                                        <option class="opt-1" selected disabled hidden>Choose...</option>
                                        <option class="opt-1" value="Selected">Selected</option>
                                        <option class="opt-1" value="Rejected">Rejected</option>
                                        <option class="opt-1" value="In Progress">In Progress</option>
                                        <option class="opt-1" value="On Hold">On Hold</option>
                                    </select>
                                </div>
                            </div>
                            <div class="col-md-6">
                                <input type="date" name="createdAt" class="form-control" id="exampleInputEmail1"  aria-describedby="emailHelp">
                            </div>
                            <div class="mb-3 mt-3 mt-lg-0">
                                <textarea class="form-control" name="summary" placeholder="Experience summary" id="exampleFormControlTextarea1" rows="2"></textarea>
                            </div>
                        </div>

                        <small class="d-block mb-1">
                            <span class="text-danger" style="font-size: medium;">*</span>
                            Do not use Picture or Video options. Use the Link option to add online references only.
                        </small>


                        <div class="mb-1">
                            <textarea id="summernote" name="content"></textarea>
                        </div>
                        <button type="submit"
                            style="width: 100%; background: linear-gradient(to right, #d4fcf4, #8ed6ff); color: black;"
                            class="btn btn-primary  mt-3">Add Experience</button>
                    </form>
                </div>
                <%- include('../INCLUDES/footer.ejs') %>
    </body>

<script>
  $(document).ready(function() {
    $('#summernote').summernote({
      height: 350,
      placeholder: "Write your interview experience here..."
    });
  });
</script>